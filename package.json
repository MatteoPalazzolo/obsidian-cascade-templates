{
	"name": "cascade-templates",
	"version": "1.0.1",
	"description": "A modular cascading templating system based on folder-level !Template.md files.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsc -p tsconfig.test.json && node --test test/*.test.cjs",
		"version": "node version-bump.mjs"
	},
	"keywords": [
		"obsidian",
		"templates"
	],
	"author": "palazz",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "^0.28.1",
		"obsidian": "~1.5.0",
		"tslib": "2.4.0",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"yaml": "^2.8.1"
	}
}
