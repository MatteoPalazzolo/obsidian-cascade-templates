{
	"name": "cascade-templates",
	"version": "1.0.2",
	"description": "A modular cascading templating system based on folder-level !Template.md files.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsc -p tsconfig.test.json && node --test test/*.test.cjs",
		"lint": "eslint .",
		"typecheck": "npx tsc -noEmit -skipLibCheck",
		"preversion": "node scripts/release-guard.mjs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
		"postversion": "node scripts/release-push.mjs"
	},
	"keywords": [
		"obsidian",
		"templates"
	],
	"author": "palazz",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "^0.28.1",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "~1.5.0",
		"tslib": "2.4.0",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.72.0"
	},
	"dependencies": {
		"yaml": "^2.8.1"
	}
}
